# ── 基础 ────────────────────────────────────────────────────────────────
PORT=3117
BIND_HOST=0.0.0.0

# 平台给你的域名。PaaS 上必须填，不然订阅里是 localhost
# PUBLIC_HOST=xxx.koyeb.app

# ── 进程伪装 ────────────────────────────────────────────────────────────
# 启动后会以同一 PID 重新 exec，ps 里显示成这个名字；off 关闭
PROC_MASK=node server.js

# ── 面板 / 数据 ─────────────────────────────────────────────────────────
PANEL=on
FEED=on
REFRESH_MINUTES=10
CACHE=on
ACCESS_LOG=off

# ── 凭证 ────────────────────────────────────────────────────────────────
# 想固定 UUID/路径就把 runs/.creds.json 压成一行填这里
# CREDS_JSON={"uuid":"...","subToken":"...","streamPath":"/ws/...","subPath":"/s/..."}
# 也可以用下面四个单独覆盖（不写回文件）
# PROXY_UUID=
# SUB_TOKEN=
# STREAM_PATH=
# SUB_PATH=

# ── 订阅链接 ────────────────────────────────────────────────────────────
SUB_PORT=443
SUB_TLS=tls
# SUB_SNI=
SUB_LABEL=Crucix
# SUB_ALPN=h2,http/1.1

# ── 资源 / 隧道 ─────────────────────────────────────────────────────────
MEM_LIMIT_MB=96
GOGC_PERCENT=50
MAX_TUNNEL_CONNS=64
MAX_SSE_CLIENTS=32
MAX_WS_PAYLOAD_BYTES=2097152
MAX_HEADER_BYTES=65536
HANDSHAKE_TIMEOUT_MS=10000
WS_HEARTBEAT_SECONDS=25
TUNNEL_IDLE_MINUTES=30
MAX_WS_BACKLOG_BYTES=16777216
MAX_UDP_BACKLOG_BYTES=1048576
VLESS_UDP_HEADER=1
TUNNEL_DEBUG=off

# ── 路径（一般不用改）────────────────────────────────────────────────────
# RUNS_DIR=runs
# CACHE_FILE=runs/snapshot.cache.json
# SNAPSHOT_FILE=assets/snapshot.json
# PANEL_DIR=
